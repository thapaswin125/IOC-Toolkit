# IOC Enrichment Pipeline — API Key Configuration
# Copy this file to .env and fill in your keys.
# All keys are optional — sources without keys are silently skipped.

# VirusTotal (free): https://www.virustotal.com/gui/my-apikey
# Free tier: 4 req/min, 500 req/day
VT_API_KEY=your_virustotal_api_key_here

# AbuseIPDB (free): https://www.abuseipdb.com/account/api
# Free tier: 1,000 checks/day — IPs only
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# AlienVault OTX (free): https://otx.alienvault.com/api
# Free tier: generous limits — IPs, domains, hashes, URLs
OTX_API_KEY=your_otx_api_key_here
